-- Políticas do Qualy Auditor: leitura/escrita para autenticados, exclusão só para gestor.
create policy qa_documents_select on public.qa_documents for select to authenticated using (true);
create policy qa_documents_insert on public.qa_documents for insert to authenticated with check (true);
create policy qa_documents_update on public.qa_documents for update to authenticated using (true) with check (true);
create policy qa_documents_delete on public.qa_documents for delete to authenticated using (public.qualyflow_is_manager());

