-- QualyFlow: perfis de acesso (gestor aprova e cadastra usuários)
create table public.qualyflow_profiles (
  user_id uuid primary key references auth.users(id) on delete cascade,
  username text not null unique,
  display_name text not null default '',
  role text not null default 'vistoriador',
  status text not null default 'pendente',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.qualyflow_profiles enable row level security;

create or replace function public.qualyflow_is_manager()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.qualyflow_profiles p
    where p.user_id = auth.uid()
      and p.role = 'gestor'
      and p.status = 'ativo'
  );
$$;

revoke all on function public.qualyflow_is_manager() from public;
grant execute on function public.qualyflow_is_manager() to authenticated;

create policy qualyflow_profiles_select on public.qualyflow_profiles
  for select to authenticated
  using (user_id = auth.uid() or public.qualyflow_is_manager());

create policy qualyflow_profiles_insert on public.qualyflow_profiles
  for insert to authenticated
  with check (public.qualyflow_is_manager());

create policy qualyflow_profiles_update on public.qualyflow_profiles
  for update to authenticated
  using (public.qualyflow_is_manager())
  with check (public.qualyflow_is_manager());

create policy qualyflow_profiles_delete on public.qualyflow_profiles
  for delete to authenticated
  using (public.qualyflow_is_manager());

create trigger qualyflow_profiles_touch before update on public.qualyflow_profiles
  for each row execute function public.qualyflow_touch_updated_at();