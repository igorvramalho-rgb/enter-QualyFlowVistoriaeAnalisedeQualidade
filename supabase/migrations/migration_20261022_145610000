create table public.qualyflow_user_settings (
  user_id uuid primary key references auth.users(id) on delete cascade,
  header jsonb not null default '{}'::jsonb,
  logos jsonb not null default '{}'::jsonb,
  updated_at timestamptz not null default now()
);

alter table public.qualyflow_user_settings enable row level security;

create policy qualyflow_user_settings_select on public.qualyflow_user_settings
  for select to authenticated
  using (user_id = auth.uid());

create policy qualyflow_user_settings_insert on public.qualyflow_user_settings
  for insert to authenticated
  with check (user_id = auth.uid());

create policy qualyflow_user_settings_update on public.qualyflow_user_settings
  for update to authenticated
  using (user_id = auth.uid())
  with check (user_id = auth.uid());

create trigger qualyflow_user_settings_touch before update on public.qualyflow_user_settings
  for each row execute function public.qualyflow_touch_updated_at();