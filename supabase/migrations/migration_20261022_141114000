insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('qualyflow-fotos', 'qualyflow-fotos', true, 10485760, array['image/jpeg','image/png','image/webp']::text[])
on conflict (id) do nothing;

create policy "qualyflow_fotos_read"
on storage.objects
for select
to public
using (bucket_id = 'qualyflow-fotos' and name like 'qualyflow/%');

create policy "qualyflow_fotos_upload"
on storage.objects
for insert
to authenticated
with check (bucket_id = 'qualyflow-fotos' and name like 'qualyflow/%');