-- 1) Endereço a partir de outra tratativa com a mesma OS
update public.qa_cases a
   set address = b.address,
       updated_at = now()
  from public.qa_cases b
 where coalesce(a.address, '') = ''
   and coalesce(a.os, '') <> ''
   and b.os = a.os
   and b.id <> a.id
   and coalesce(b.address, '') <> '';

-- 2) Endereço a partir do relatório do Emissor (mesma OS)
update public.qa_cases c
   set address = r.endereco,
       updated_at = now()
  from (
    select distinct on (values->>'os')
           values->>'os' as os,
           regexp_replace(trim(values->>'endereco'), '\s+', ' ', 'g') as endereco
      from public.qualyflow_reports
     where coalesce(values->>'os', '') <> ''
       and coalesce(values->>'endereco', '') <> ''
  ) r
 where coalesce(c.address, '') = ''
   and c.os = r.os;

-- 3) Normaliza espaços e vírgulas dos endereços existentes
update public.qa_cases
   set address = regexp_replace(regexp_replace(trim(address), '\s+', ' ', 'g'), '\s*,\s*', ', ', 'g')
 where address ~ '\s{2,}' or address ~ '\s,' or address ~ ',\s{2,}' or address <> trim(address);